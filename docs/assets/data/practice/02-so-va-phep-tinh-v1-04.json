{"version":2,"schema":"practice-question-chunk-v1","bank_id":"NUM02-V1-04","topic":{"id":"02-so-va-phep-tinh","title":"Số và phép tính"},"questions":[{"id":"NUM02V1_091","question":"\\(25\\%\\) viết dưới dạng số thập phân là:","options":["\\(0,25\\)","\\(2,5\\)","\\(0,025\\)","\\(25\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram"],"type":"doi-dang"},"difficulty":"basic","explanation":"\\(25\\%=25/100=0,25\\)."},{"id":"NUM02V1_092","question":"\\(0,4\\) viết dưới dạng phần trăm là:","options":["\\(40\\%\\)","\\(4\\%\\)","\\(0,4\\%\\)","\\(400\\%\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram"],"type":"doi-dang"},"difficulty":"basic","explanation":"Nhân số thập phân với 100%: \\(0,4=40\\%\\)."},{"id":"NUM02V1_093","question":"\\(15\\%\\) của 200 bằng:","options":["\\(30\\)","\\(15\\)","\\(20\\)","\\(170\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram"],"type":"tim-phan-tram"},"difficulty":"basic","explanation":"\\(200\\cdot15/100=30\\)."},{"id":"NUM02V1_094","question":"Một số bằng 40% của 250. Số đó là:","options":["\\(100\\)","\\(625\\)","\\(90\\)","\\(110\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram"],"type":"tim-phan-tram"},"difficulty":"basic","explanation":"\\(250\\cdot0,4=100\\)."},{"id":"NUM02V1_095","question":"80 tăng 25% thì được:","options":["\\(100\\)","\\(105\\)","\\(95\\)","\\(120\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram"],"type":"tang-phan-tram"},"difficulty":"basic","explanation":"Tăng 25%: \\(80(1+0,25)=80\\cdot1,25=100\\)."},{"id":"NUM02V1_096","question":"500 giảm 20% thì còn:","options":["\\(400\\)","\\(480\\)","\\(300\\)","\\(450\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram"],"type":"giam-phan-tram"},"difficulty":"basic","explanation":"Giảm 20% tức còn 80%: \\(500\\cdot0,8=400\\)."},{"id":"NUM02V1_097","question":"Một món hàng 800.000đ giảm 15%. Giá mới là:","options":["680.000đ","700.000đ","720.000đ","785.000đ"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram","bai-toan-thuc-te"],"type":"giam-gia"},"difficulty":"intermediate","explanation":"Giá mới bằng \\(800000\\cdot0,85=680000\\) đồng."},{"id":"NUM02V1_098","question":"Một giá trị tăng từ 120 lên 150. Tỉ lệ tăng là:","options":["\\(25\\%\\)","\\(20\\%\\)","\\(30\\%\\)","\\(15\\%\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram"],"type":"ti-le-thay-doi"},"difficulty":"intermediate","explanation":"Mức tăng là 30; \\(30/120=0,25=25\\%\\)."},{"id":"NUM02V1_099","question":"Một món hàng giảm 15% rồi giảm tiếp 10% trên giá mới. Tổng mức giảm so với giá ban đầu là:","options":["\\(23,5\\%\\)","\\(25\\%\\)","\\(24\\%\\)","\\(21,5\\%\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram","bai-toan-thuc-te"],"type":"giam-lien-tiep"},"difficulty":"advanced","explanation":"Giá còn \\(0,85\\cdot0,90=0,765\\), tức giảm \\(1-0,765=0,235=23,5\\%\\)."},{"id":"NUM02V1_100","question":"Tăng 20% rồi giảm 20% trên giá mới, so với ban đầu kết quả:","options":["Giảm 4%","Không đổi","Tăng 4%","Giảm 20%"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram"],"type":"tang-giam-lien-tiep"},"difficulty":"advanced","explanation":"Hệ số thay đổi là \\(1,2\\cdot0,8=0,96\\), nên còn 96% giá trị ban đầu, tức giảm 4%."},{"id":"NUM02V1_101","question":"Trong lớp 40 học sinh có 18 nữ. Tỉ lệ học sinh nữ là:","options":["\\(45\\%\\)","\\(40\\%\\)","\\(55\\%\\)","\\(18\\%\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram","bai-toan-thuc-te"],"type":"ti-le-phan-tram"},"difficulty":"intermediate","explanation":"\\(18/40=0,45=45\\%\\)."},{"id":"NUM02V1_102","question":"Một số sau khi tăng 10% thành 220. Số ban đầu là:","options":["\\(200\\)","\\(198\\)","\\(210\\)","\\(242\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram"],"type":"tim-gia-tri-ban-dau"},"difficulty":"intermediate","explanation":"Gọi số ban đầu là \\(x\\), ta có \\(1,1x=220\\), nên \\(x=200\\)."},{"id":"NUM02V1_103","question":"\\(\\sqrt{49}\\) bằng:","options":["\\(7\\)","\\(-7\\)","\\(\\pm7\\)","\\(49\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["can-bac-hai"],"type":"tinh-can"},"difficulty":"basic","explanation":"Kí hiệu \\(\\sqrt{49}\\) chỉ căn bậc hai không âm, nên bằng 7."},{"id":"NUM02V1_104","question":"\\(\\sqrt{0}\\) bằng:","options":["\\(0\\)","\\(1\\)","Không xác định","\\(-1\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["can-bac-hai"],"type":"tinh-can"},"difficulty":"basic","explanation":"Vì \\(0^2=0\\), nên \\(\\sqrt0=0\\)."},{"id":"NUM02V1_105","question":"Số nào có căn bậc hai số học bằng 12?","options":["\\(144\\)","\\(24\\)","\\(12\\)","\\(120\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["can-bac-hai"],"type":"nguoc-can"},"difficulty":"basic","explanation":"Nếu \\(\\sqrt a=12\\) thì \\(a=12^2=144\\)."},{"id":"NUM02V1_106","question":"So sánh \\(\\sqrt{16}\\) và 5.","options":["\\(\\sqrt{16}<5\\)","\\(\\sqrt{16}>5\\)","\\(\\sqrt{16}=5\\)","Không so sánh được"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["can-bac-hai"],"type":"so-sanh"},"difficulty":"basic","explanation":"\\(\\sqrt{16}=4<5\\)."},{"id":"NUM02V1_107","question":"Giá trị của \\(\\sqrt{81}+\\sqrt{25}\\) là:","options":["\\(14\\)","\\(106\\)","\\(56\\)","\\(4\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["can-bac-hai"],"type":"tinh-can"},"difficulty":"basic","explanation":"\\(\\sqrt{81}=9\\), \\(\\sqrt{25}=5\\), nên tổng là 14."},{"id":"NUM02V1_108","question":"Khẳng định nào đúng?","options":["\\(\\sqrt{25}=5\\)","\\(\\sqrt{25}=\\pm5\\)","\\(\\sqrt{-25}=5\\) trong \\(\\mathbb R\\)","\\(\\sqrt{36}=-6\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["can-bac-hai"],"type":"khai-niem"},"difficulty":"intermediate","explanation":"Căn bậc hai số học là giá trị không âm, vì vậy \\(\\sqrt{25}=5\\)."},{"id":"NUM02V1_109","question":"Một bể đang có \\(\\frac35\\) dung tích nước, dùng đi \\(\\frac14\\) lượng nước đang có. Phần dung tích còn lại là:","options":["\\(\\frac9{20}\\)","\\(\\frac7{20}\\)","\\(\\frac25\\)","\\(\\frac{3}{20}\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phep-tinh-phan-so","bai-toan-thuc-te"],"type":"phan-so-thuc-te"},"difficulty":"advanced","explanation":"Dùng đi \\(\\frac14\\cdot\\frac35=\\frac3{20}\\) dung tích; còn \\(\\frac35-\\frac3{20}=\\frac9{20}\\)."},{"id":"NUM02V1_110","question":"Một quãng đường 120 km, xe đã đi 35%. Quãng đường đã đi là:","options":["42 km","35 km","78 km","84 km"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram","bai-toan-thuc-te"],"type":"phan-tram-thuc-te"},"difficulty":"intermediate","explanation":"\\(120\\cdot35/100=42\\) km."},{"id":"NUM02V1_111","question":"Một cuốn sách 240 trang, Minh đọc \\(\\frac38\\) số trang. Minh đã đọc:","options":["90 trang","80 trang","120 trang","150 trang"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phep-tinh-phan-so","bai-toan-thuc-te"],"type":"phan-so-thuc-te"},"difficulty":"intermediate","explanation":"\\(240\\cdot3/8=90\\) trang."},{"id":"NUM02V1_112","question":"Nhiệt độ buổi sáng là \\(-3^\\circ C\\), trưa tăng 8°C. Nhiệt độ trưa là:","options":["\\(5^\\circ C\\)","\\(-11^\\circ C\\)","\\(11^\\circ C\\)","\\(-5^\\circ C\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["so-nguyen-phep-tinh","bai-toan-thuc-te"],"type":"so-nguyen-thuc-te"},"difficulty":"basic","explanation":"\\(-3+8=5\\), nên nhiệt độ trưa là \\(5^\\circ C\\)."},{"id":"NUM02V1_113","question":"Một thang máy ở tầng 4 đi xuống 7 tầng. Nếu tầng trệt là 0, thang máy đến tầng:","options":["\\(-3\\)","\\(3\\)","\\(-11\\)","\\(11\\)"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["so-nguyen-phep-tinh","bai-toan-thuc-te"],"type":"so-nguyen-thuc-te"},"difficulty":"basic","explanation":"Vị trí mới là \\(4-7=-3\\)."},{"id":"NUM02V1_114","question":"Một đội có 24 nam và 36 nữ cần chia thành các nhóm giống nhau, số nhóm nhiều nhất là:","options":["12 nhóm","6 nhóm","8 nhóm","18 nhóm"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["ucln","bai-toan-thuc-te"],"type":"chia-nhom"},"difficulty":"intermediate","explanation":"Số nhóm nhiều nhất là ƯCLN\\((24,36)=12\\)."},{"id":"NUM02V1_115","question":"Hai chuông reo theo chu kì 8 phút và 12 phút. Cùng reo lúc 8:00, lần tiếp theo cùng reo lúc:","options":["8:24","8:20","8:48","8:12"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["bcnn","bai-toan-thuc-te"],"type":"chu-ki"},"difficulty":"intermediate","explanation":"BCNN\\((8,12)=24\\), nên sau 24 phút, tức 8:24, chúng lại cùng reo."},{"id":"NUM02V1_116","question":"Một sản phẩm giá 1.200.000đ tăng 10%. Giá mới là:","options":["1.320.000đ","1.210.000đ","1.080.000đ","1.440.000đ"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram","bai-toan-thuc-te"],"type":"tang-gia"},"difficulty":"intermediate","explanation":"Giá mới là \\(1.200.000\\cdot1,10=1.320.000\\) đồng."},{"id":"NUM02V1_117","question":"Một mảnh đất hình vuông có diện tích 144 m². Cạnh mảnh đất dài:","options":["12 m","72 m","24 m","14 m"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["can-bac-hai","bai-toan-thuc-te"],"type":"can-thuc-te"},"difficulty":"intermediate","explanation":"Cạnh hình vuông bằng căn bậc hai của diện tích: \\(\\sqrt{144}=12\\) m."},{"id":"NUM02V1_118","question":"Một cửa hàng bán 60% của 250 sản phẩm. Số sản phẩm đã bán là:","options":["150","100","160","200"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phan-tram","bai-toan-thuc-te"],"type":"phan-tram-thuc-te"},"difficulty":"basic","explanation":"\\(250\\cdot0,60=150\\) sản phẩm."},{"id":"NUM02V1_119","question":"Một người có 600.000đ, dùng \\(\\frac25\\) số tiền rồi dùng tiếp 20% số tiền ban đầu. Số tiền còn lại là:","options":["240.000đ","120.000đ","360.000đ","300.000đ"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phep-tinh-phan-so","phan-tram","bai-toan-thuc-te"],"type":"hon-hop-thuc-te"},"difficulty":"advanced","explanation":"Dùng \\(2/5\\) của 600.000 là 240.000đ và 20% ban đầu là 120.000đ; còn \\(600.000-360.000=240.000\\)đ."},{"id":"NUM02V1_120","question":"Một lớp có 48 học sinh. \\(\\frac14\\) học sinh đạt loại A, 37,5% đạt loại B. Số học sinh còn lại là:","options":["18","12","16","20"],"answer":0,"tags":{"topic":"so-va-phep-tinh","skill":["phep-tinh-phan-so","phan-tram","bai-toan-thuc-te"],"type":"hon-hop-thuc-te"},"difficulty":"advanced","explanation":"Loại A: \\(48\\cdot1/4=12\\); loại B: \\(48\\cdot0,375=18\\). Còn \\(48-12-18=18\\)."}]}