  "roles": {
    "project_owner": {
      "lead_on": [
        "product priorities",
        "learning experience goals",
        "final product direction"
      ],
      "not_expected_to_do": [
        "technical QA",
        "manual GitHub integration",
        "mathematical cross-checking between AIs"
      ]
    },
    "gemini": {
      "lead_on": [
        "pedagogical critique",
        "academic drafting",
        "examples and exercise generation",
        "independent solution of difficult math problems"
      ],
      "review_on": [
        "curriculum mapping",
        "geometry reasoning",
        "student-facing explanations"
      ],
      "constraints": [
        "Do not assume repository state that is not in context.",
        "Do not mix Specialized-Challenge into KNTT-Core.",
        "Mark uncertainty explicitly."
      ]
    },
    "chatgpt": {
      "lead_on": [
        "repository architecture",
        "GitHub integration",
        "schemas and metadata",
        "technical QA",
        "practice engine",
        "SVG generation from verified specs",
        "release and deploy"
      ],
      "review_on": [
        "academic correctness",
        "pedagogical consistency",
        "hard-problem independent verification"
      ],
      "constraints": [
        "Do not self-certify high-risk geometry or advanced proofs without an independent check when feasible.",
        "Preserve backward compatibility unless migration is deliberate."
      ]
    }
  },
  "dual_review_required_for": [
    "multi-step geometry proofs",
    "specialized/high-achievement problems",
    "solutions with non-obvious theorem use",
    "canonical answer keys reused across the bank",
    "areas where prior AI answers were unstable or conflicting"
  ],
