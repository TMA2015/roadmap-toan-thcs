{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-taxonomy-v2-registry-r1",
  "title": "Skill Taxonomy v2 Registry R1",
  "type": "object",
  "required": ["schema", "version", "status", "families", "legacy_mappings", "runtime_enabled"],
  "properties": {
    "schema": { "const": "skill-taxonomy-v2-registry-r1" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "type": "string" },
    "runtime_enabled": { "const": false },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family_id", "label_vi", "layer", "topics", "diagnostic_subskills"],
        "properties": {
          "family_id": { "type": "string", "minLength": 1 },
          "label_vi": { "type": "string", "minLength": 1 },
          "layer": {
            "enum": ["KNTT-Core", "Core-Support", "THPT-Bridge", "Entrance10", "Specialized-Challenge"]
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^CT\\d{2}$" },
            "uniqueItems": true
          },
          "diagnostic_subskills": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "learner_visible_default": { "type": "boolean" },
          "optional_section": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "legacy_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic_id", "legacy_id", "role"],
        "properties": {
          "topic_id": { "type": "string", "pattern": "^CT\\d{2}$" },
          "legacy_id": { "type": "string", "minLength": 1 },
          "family_id": { "type": ["string", "null"] },
          "role": {
            "enum": ["ASSESSED_SKILL", "SUPPORTING_SKILL", "METHOD", "CONTEXT", "CATEGORY", "COMPOSITE_TASK", "CROSS_TOPIC_REUSE"]
          },
          "layer": {
            "enum": ["KNTT-Core", "Core-Support", "THPT-Bridge", "Entrance10", "Specialized-Challenge"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
