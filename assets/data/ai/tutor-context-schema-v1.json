{
  "schema": "roadmap-tutor-context-v1",
  "version": "1.0",
  "required": [
    "context_version",
    "policy_version",
    "current_layer",
    "current_task",
    "learner_evidence",
    "graph_context"
  ],
  "properties": {
    "context_version": "project context version",
    "policy_version": "Tutor Contract policy version",
    "current_layer": "KNTT-Core | Entrance10 | Specialized-Challenge",
    "grade_overlay": "optional grade 6-9",
    "current_task": {
      "skill": "skill id",
      "question_id": "optional",
      "question_text": "optional",
      "learner_answer": "optional",
      "hint_level": "integer"
    },
    "learner_evidence": {
      "target": "evidence snapshot",
      "prerequisites": "array of evidence snapshots",
      "remediation_history": "bounded recent events",
      "observed_signals": "up to 5 recent option-level misconception signals for the current skill; observed evidence only, never a diagnosis by itself"
    },
    "graph_context": {
      "reviewed_prerequisites": "high-confidence PREREQUISITE only",
      "remediation_candidates": "reviewed rule candidates",
      "sequence_links": "optional, explicitly non-causal"
    },
    "learner_request": "optional free text",
    "privacy": {
      "rule": "Send only minimum context needed for the current tutoring turn; observed signals are bounded to the current skill; do not send full localStorage or unrelated learner history."
    }
  }
}
